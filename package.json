  },
  "dependencies": {
    "@google/genai": "3.2.0",
    "@neon/config": "1.14.0",
    "@neon/env": "2.1.3",
    "@neondatabase/serverless": "1.2.0",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
