{
  "name": "brand-intelligence-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dashboard": "tsx src/web/server.ts",
    "report:once": "tsx src/cli/run-once.ts",
