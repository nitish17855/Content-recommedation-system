# Gemini API (Free-tier eligible models only; zero paid APIs)
GEMINI_API_KEY=
# Optional comma-separated additional Gemini API keys from separate Google accounts for rotation/failover
GEMINI_API_KEYS=
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
GEMINI_MODEL_REASONING=gemini-3.8-flash
GEMINI_MODEL_CRITIC=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# OpenRouter API (Optional free-tier offload for Context + Matching stages)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Pipeline tuning
LOOKBACK_DAYS=14
MAX_CLUSTERS_FOR_LLM=8
REPORT_INTERVAL_DAYS=15

# Optional later-phase / database / dashboard variables
DATABASE_URL=
YOUTUBE_API_KEY=
APP_BASE_URL=
APP_AUTH_SECRET=
OWNER_AUTH_PASSWORD_HASH=

